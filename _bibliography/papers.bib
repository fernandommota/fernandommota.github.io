@inproceedings{salas2012icsc,
  preview     = {statistical_data_web.png},
  abbr        = {ICSC},
  bibtex_show = {true},
  title       = {Publishing Statistical Data on the Web},
  author      = {Salas, Percy E. Rivera and Martin, Michael and da Mota, Fernando Maia and Auer, Sören and Breitman, Karin K. and Casanova, Marco A.},
  booktitle   = {Proceedings of the 6th IEEE International Conference on Semantic Computing (ICSC)},
  address     = {Palermo, Italy},
  publisher   = {IEEE},
  pages       = {285--292},
  year        = {2012},
  doi         = {10.1109/ICSC.2012.16},
  abstract    = {Statistical data is one of the most important sources of information, relevant for large numbers of stakeholders in the governmental, scientific and business domains alike. In this article, we overview how statistical data can be managed on the Web. With OLAP2DataCube and CSV2DataCube we present two complementary approaches on how to extract and publish statistical data. We also discuss the linking, repair and the visualization of statistical data. As a comprehensive use case, we report on the extraction and publishing on the Web of statistical data describing 10 years of life in Brazil.},
  html        = {https://research.uni-hannover.de/en/publications/publishing-statistical-data-on-the-web/},
  pdf         = {https://www-di.inf.puc-rio.br/~casanova/Publications/Papers/2012-Papers/2012-ICSC.pdf}
}

