@mastersthesis{mota2016msc,
  preview     = {mota2016msc.png},
  abbr        = {MSc},
  title       = {Uma Abordagem de Análises {OLAP} e de Mineração de Dados para Suporte à Tomada de Decisão no Setor da Pecuária de Corte do Brasil},
  author      = {da Mota, Fernando Maia},
  school      = {Universidade Federal de Mato Grosso do Sul (UFMS)},
  type        = {Professional master's thesis in Applied Computing},
  address     = {Campo Grande, Brazil},
  year        = {2016},
  abstract    = {Observa-se na atividade da agropecuária brasileira esforços voltados para a produção de carne bovina com qualidade acima da média brasileira. Recentemente, a indústria da carne criou programas de incentivo à produção de carcaças bovinas com características específicas como sexo, peso de carcaça, idade do animal e grau de acabamento (gordura sobre a carcaça) com bonificação para as carcaças que se enquadrem e descontos para as que não. Problemas no processo de produção e de abate nas indústrias frigoríficas costumam ser o principal motivo de desclassificação de carcaças e, consequentemente, de perdas financeiras dos pecuaristas. Portanto, neste trabalho é proposta uma abordagem de análise de dados que utiliza de meios computacionais como armazém de dados (Data Warehouse), consultas analíticas online (OLAP) e mineração de dados (Data Mining) integradas e em conjunto com as habilidades humanas para servir de suporte à tomada de decisão. A abordagem se divide em 4 etapas, a primeira é responsável pela extração, transformação e carga dos dados fornecidos pela Associação Sul-matogrossense de Produtores de Novilho Precoce (ASPNP), seguido da etapa de criação do modelo multidimensional para armazenagem dos dados oriundos da primeira etapa. Na sequência a etapa de visualização e exploração dos dados armazenados no Data Warehouse, é caracterizada pela configuração e personalização das ferramentas da suíte open source Pentaho. Na última etapa é realizada a aplicação de algoritmos de Data Mining com a ferramenta open source Weka com objetivo de descobrir padrões e relacionamentos vinculados ao grau de acabamento e ao rendimento de carcaça. Os resultados alcançados até a terceira etapa na forma de um portal de análise de dados da ASPNP se mostraram satisfatórios, uma vez que encontram-se em efetivo uso e constante evolução. Embora a quarta etapa tenha sido concluída, durante sua execução foram identificadas inconsistências nos dados fornecidos, como por exemplo o armazenamento do peso vivo do animais na forma de média por lote, isso ocasiona perda de precisão na aplicação dos algoritmos de Data Mining. Em contrapartida, ao se utilizar um conjunto de dados considerado ideal foi possível obter classificadores com taxa de acerto médio entre 70% a 80%. Desta forma, os resultados da quarta etapa evidenciam que é possível utilizar de técnicas de Data Mining no contexto deste trabalho mas que para isso é necessário que os dados utilizados sejam precisos e consistentes.},
  pdf         = {mota2016msc.pdf}
}

